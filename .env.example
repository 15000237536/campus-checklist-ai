# ============================================================
#  环境变量配置 —— 复制本文件为 .env，填入你自己的密钥
#  注意：.env 文件永远不要提交到 Git，不要暴露给前端！
# ============================================================

# 必填：你的大模型 API Key（不会出现在前端）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：API 地址，默认 OpenAI 官方。
# 国内常用兼容地址举例：
#   通义千问 DashScope:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:            https://open.bigmodel.cn/api/paas/v4
#   Moonshot 月之暗面:   https://api.moonshot.cn/v1
#   DeepSeek:            https://api.deepseek.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# 视觉模型（第一步读图用），需要支持图片输入的多模态模型
#   OpenAI:    gpt-4o / gpt-4o-mini / gpt-4.1-mini
#   通义千问:   qwen-vl-max / qwen-vl-plus
#   智谱:       glm-4v-flash / glm-4v-plus
#   Moonshot:   moonshot-v1-vision
VISION_MODEL=gpt-4o

# 文本模型（第二步提取关键词/待办用），用普通文本模型即可，省钱可以换小模型
#   如果和视觉模型是同一个，留空即可（默认复用 VISION_MODEL）
TEXT_MODEL=gpt-4o

# 可选：服务器端口，默认 3000
PORT=3000
